# Public Supabase Credentials (Safe for browser bundle, protected via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEV1cnqiM0oG01ZH
# Server-Only Privileged Credentials (DO NOT prefix with NEXT_PUBLIC_)
# Never expose service-role keys, database passwords, or signing secrets to client-side code.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

